
@{
    ViewBag.Title = "Download";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Excelダウンロード</h2>
<div id="overlay" style="
display:none;
position:fixed;
top:0; left:0;
width:100%; height:100%;
background:rgba(0,0,0,0.4);
color:white;
font-size:20px;
text-align:center;
padding-top:200px;
z-index:9999;">
    ダウンロード中です。しばらくお待ちください…
</div>

<button onclick="startDownload()">出力</button>
<div id="loading" style="display:none;">
    ダウンロード中です…
</div>
<a class="btn btn-primary"
   href="@Url.Action("DownloadUkebaraiboExcel", "Ukebaraibo", new { siteId = "S001" })">
    受払簿一覧
</a>

<a class="btn btn-secondary"
   href="@Url.Action("DownloadCorporateMaisu", "Ukebaraibo", new { siteId = "S001" })">
    会社別・区分別 枚数
</a>


